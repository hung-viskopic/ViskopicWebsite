# Add these values in Render. Never commit real credentials.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@POOLER_HOST:5432/postgres?sslmode=require
S3_ENDPOINT=https://PROJECT_REF.storage.supabase.co/storage/v1/s3
S3_REGION=eu-central-1
S3_ACCESS_KEY=replace-with-server-side-s3-access-key
S3_SECRET_KEY=replace-with-server-side-s3-secret-key
S3_BUCKET=submissions
DEV_ACCESS_KEY=replace-with-a-long-random-workspace-key
ORGANISATION_ID=viskopic-demo
