# Copy to .env. Generate the master key with:
#   python3 -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Losing this key makes all locally stored documents unreadable (that is the point).
VISKOPIC_LOCAL_MASTER_KEY_B64=

# Local-only passwords (defaults are fine on your own machine).
POSTGRES_PASSWORD=viskopic
VISKOPIC_APP_PASSWORD=viskopic_app
KEYCLOAK_ADMIN_PASSWORD=admin

# Host ports. Change any of these if `docker compose up` says a port is not available.
POSTGRES_HOST_PORT=15432
KEYCLOAK_HOST_PORT=18080
API_HOST_PORT=8000
S3_HOST_PORT=8333
MAILPIT_HOST_PORT=8025
# The web app stays on 3000 (Keycloak's demo realm expects it).

# Demonstration profiles for the evidence report (local development only).
VISKOPIC_ALLOW_DEMO_PROFILES=true
# Score texts nobody has quality-reviewed yet, labelled "unreviewed demonstration" (local development only).
# Demonstration profiles only produce a result with this on.
VISKOPIC_ALLOW_UNREVIEWED_CONSISTENCY=true

# Viva: external AI. Visq 2 (OpenRouter with zero data retention, or OpenAI) reads the submission and writes the
# viva's questions as it goes; OpenAI transcribes spoken answers in vivas with your own questions. This sends essays, answers and
# recordings to outside providers, so use it only with synthetic test essays, never real students.
# The switch must be on; leave the keys empty (and the switch false) anywhere outside local development.
VISKOPIC_ALLOW_EXTERNAL_AI=false
# Visq provider: "openrouter" (Visq's own model, zero data retention enforced) or "openai" (uses
# VISKOPIC_OPENAI_API_KEY below; responses not stored, but no zero-retention guarantee).
VISKOPIC_VISQ_PROVIDER=openrouter
VISKOPIC_OPENROUTER_API_KEY=
# VISKOPIC_VISQ_MODEL=openai/gpt-oss-120b
# VISKOPIC_VIVA_FOLLOWUP_WAIT_SECONDS=90
VISKOPIC_VIVA_AI_PROVIDER=openai
VISKOPIC_OPENAI_API_KEY=
# VISKOPIC_OPENAI_TRANSCRIBE_MODEL=whisper-1

# Pipeline 2 (interchangeability): AI comparison essays per assignment, generated once from the assignment
# prompt only (no student work is sent). Uses VISKOPIC_OPENAI_API_KEY (GPT family only for now).
VISKOPIC_P2_GENERATE_COMPARISONS=false
